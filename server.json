{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.GeiserX/pumperly-mcp",
  "title": "Pumperly",
  "description": "Cheapest fuel and EV charging near a place or along a drive, in about 40 countries",
  "websiteUrl": "https://github.com/GeiserX/pumperly-mcp",
  "icons": [
    {
      "src": "https://pumperly.com/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/GeiserX/pumperly-mcp",
    "source": "github",
    "id": "1198347284"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "pumperly-mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PUMPERLY_URL",
          "description": "Pumperly instance URL (default https://pumperly.com); set it to use your own instance",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "default": "https://pumperly.com"
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "drumsergio/pumperly-mcp:v0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PUMPERLY_URL",
          "description": "Pumperly instance URL (default https://pumperly.com); set it to use your own instance",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "default": "https://pumperly.com"
        }
      ]
    }
  ]
}
